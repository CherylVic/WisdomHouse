     * è¿” å›ž å€¼: è¿”å›žå­—ç¬¦ä¸²åŒ–çš„IPåœ°å€
     ***************************************************************/
    ipNumber2String(ip) {
        if (ip < 0 || ip > 0xFFFFFFFF) {
            throw ("The number is not normal!");
        }
        return (ip >>> 24) + "." + (ip >> 16 & 0xFF) + "." + (ip >> 8 & 0xFF) + "." + (ip & 0xFF);
    }
    // è§£æžArrayBuffer
    /***************************************************************
     * å‡½æ•°åç§°: arrayBuffer2String
     * è¯´    æ˜Ž: è§£æžArrayBufferï¼Œå°†å…¶è½¬åŒ–ä¸ºå­—ç¬¦ä¸²
     * å‚    æ•°:
