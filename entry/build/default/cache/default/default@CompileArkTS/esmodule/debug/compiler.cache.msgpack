import router from '@ohos.router'

import UdpProcess from '../entryability/UdpProcess'
import Protocol, { ProtocolResult } from '../entryability/Protocol'

@Entry @Component export struct DeviceList {
  private display_height: number
  private display_width: number

  private device_select: number = 0

  /***************************************************************
   * å‡½æ•°åç§°: aboutToAppear
   * è¯´    æ˜Ž: é¡µé¢è¢«è°ƒç”¨æ—¶ï¼Œåœ¨è°ƒç”¨build()ä¹‹å‰ï¼Œæ‰§è¡ŒaboutToAppear()
   * å‚    æ•°: æ— 
   * è¿” å›ž å€¼: æ— 
   ***************************************************************/
  aboutToAppear() {
    let mDisplay = display.getDefaultDisplaySync()
    let height: number = px2vp(mDisplay.height)
    let width: number = px2vp(mDisplay.width)

    this.display_height = height
    this.display_width = width
  }

  build() {
    Column() {
      Row() {
        Button('è¿”å›ž')
          .fontSize(25)
          .onClick(() => {
            router.back() // è¿”å›žä¸Šä¸€é¡µ
          })

        Text('é€‰æ‹©æ™ºæ…§å°å±‹')
          .fontSize(30)
          .fontColor('#ff00aa00')

        Button('ç¡®å®š')
          .fontSize(25)
          .onClick(() => {
            if (UdpProcess.remote_device_status.length == 0) {
              AlertDialog.show(
                {
                  title: 'å‘Šè­¦',
                  message: 'å½“å‰å±€åŸŸç½‘å†…æ— æ™ºæ…§å°å±‹',
                  autoCancel: true,
                  alignment: DialogAlignment.Bottom,
                  offset: { dx: 0, dy: -20 },
                  gridCount: 3,
                  confirm: {
                    value: 'ç¡®å®š',
                    action: () => {
                      console.info('DeviceList: å½“å‰å±€åŸŸç½‘å†…æ— æ™ºæ…§å°å±‹ and actiion')
                    }
                  },
                  cancel: () => {
                    console.info('DeviceList: å½“å‰å±€åŸŸç½‘å†…æ— æ™ºæ…§å°å±‹ and cancel')
                  }
                }
              )
              return
            }
            UdpProcess.remote_device_select = this.device_select
            router.back() // è¿”å›žä¸Šä¸€é¡µ
          })
      }
        .width('100%')
        .justifyContent(FlexAlign.SpaceBetween)
        .padding({
          top: 10,
          left: 10,
          right: 10,
          bottom: 10,
        })


      List() {
        ForEach(UdpProcess.remote_device_status, (item, index) => {
          ListItem() {
            Row() {
              Text("è®¾å¤‡å·ï¼š" + item.deviceId)
                .fontSize(20)
              Button('é€‰æ‹©è¯¥è®¾å¤‡')
                .fontSize(20)
                .onClick(() => {
                  this.device_select = index
                })
            }
              .width('100%')
              .justifyContent(FlexAlign.SpaceAround)
          }
        })
      }
        .padding({
          top: 10,
          left: 10,
          right: 10,
          bottom: 10,
        })

    }
    .width('100%')
    .height('100%')
    .justifyContent(FlexAlign.Start)
    .padding({
      top: 10,
      left: 10,
      right: 10,
    })
    .backgroundColor('#ffc6c6c6')
  }
