        for (i = 0; i < this.remote_device_status.length; i++) {
            if (deviceId === this.remote_device_status[i].deviceId) {
                // ç›¸åŒçš„IPåœ°å€
                return;
            }
        }
        // æ•°ç»„ä¸­æ²¡æœ‰ï¼Œåˆ™æ·»åŠ 
        this.remote_device_status.push({
            remote_info: remoteInfo,
            deviceId: deviceId,
            temperator: 25,
            humidity: 25,
            lumination: 25,
            is_rain: 0,
            is_smoke: 0,
            is_fire: 0
        });
    }
