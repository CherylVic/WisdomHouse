export default new UdpProcess()Ôrj“ª./Protocol°@ohos.net.socketª@ohos.wifiGBÂÙND:\Huawei\projects\WisdomHouse_App\entry\src\main\ets\entryability\Protocol.tsBÃªoh-resolveÂGBÂÙ.␀rollup_plugin_ignore_empty_module_placeholderBÃ¬ignorePluginÂGBÂÙ.␀rollup_plugin_ignore_empty_module_placeholderBÃ¬ignorePluginÂÂÔ␀␀H“d±ImportDeclaration␀&‘e¶ImportDefaultSpecifierKªIdentifier¦socketQ§Literal%°@ohos.net.socket²'@ohos.net.socket'd±ImportDeclaration(ÌF‘e¶ImportDefaultSpecifier/3KªIdentifier/3¤wifiQ§Literal9ÌEª@ohos.wifi¬"@ohos.wifi"d±ImportDeclarationÌHÌ~’e¶ImportDefaultSpecifierÌOÌWKªIdentifierÌOÌW¨Protocoli¯ImportSpecifierÌ[ÌiKªIdentifierÌ[Ìi®ProtocolResultKªIdentifierÌ[Ìi®ProtocolResultQ§LiteralÌqÌ}ª./Protocol¬'./Protocol'ABÚDÌexport var ProtocolResult;
(function (ProtocolResult) {
    ProtocolResult[ProtocolResult["ProtocolResult_Success"] = 0] = "ProtocolResult_Success";
    ProtocolResult[ProtocolResult["ProtocolResult_PacketLength"] = 1] = "ProtocolResult_PacketLength";
    ProtocolResult[ProtocolResult["ProtocolResult_PacketDeviceId"] = 2] = "ProtocolResult_PacketDeviceId";
    ProtocolResult[ProtocolResult["ProtocolResult_PacketDeviceType"] = 3] = "ProtocolResult_PacketDeviceType";
    ProtocolResult[ProtocolResult["ProtocolResult_PacketCmd"] = 4] = "ProtocolResult_PacketCmd";
    ProtocolResult[ProtocolResult["ProtocolResult_SelectError"] = 5] = "ProtocolResult_SelectError";
})(ProtocolResult || (ProtocolResult = {}));
class Protocol {
    /***************************************************************
     * å‡½æ•°åç§°: constructor
     * è¯´    æ˜Ž: ç±»åˆå§‹åŒ–æ—¶ï¼Œè§¦å‘è¯¥å‡½æ•°
     * å‚    æ•°: æ— 
     * è¿” å›ž å€¼: æ— 
     ***************************************************************/
    constructor() {
        // æŠ¥æ–‡ä½ç§»
        this.offset_device_id = 0; // è®¾å¤‡å·ä½ç§»
        this.offset_device_type = 12; // è®¾å¤‡ç±»åž‹ä½ç§»
        this.offset_cmd = 14; // å‘½ä»¤ä½ç§»
        this.offset_result = 16; // è¿”å›žå€¼ä½ç§»
        this.offset_data = 17; // æ•°æ®éƒ¨åˆ†ä½ç§»
        // é•¿åº¦
        this.length_device_id = 12; // è®¾å¤‡å·é•¿åº¦
        this.length_device_type = 2; // è®¾å¤‡ç±»åž‹é•¿åº¦
        this.length_cmd = 2; // å‘½ä»¤ç±»åž‹é•¿åº¦
        this.length_result = 1; // åé¦ˆç»“æžœé•¿åº¦
        // é»˜è®¤å€¼
        this.deviceType_WisdomHouse = 1; // è®¾å¤‡ç±»åž‹æ˜¯æ™ºæ…§å°å±‹
        // å‘½ä»¤ç±»åž‹
        this.cmd_findDevice = 1; // æŸ¥æ‰¾è®¾å¤‡å·
        this.cmd_reportHouseStatus = 2; // ä¸ŠæŠ¥å°å±‹çŠ¶æ€
        this.cmd_setDoor = 3; // è®¾ç½®é—¨å¼€å…³
        this.cmd_setGarageDoor = 4; // è®¾ç½®è½¦åº“å¼€å…³
        this.cmd_setWindow = 5; // è®¾ç½®çª—å£å¼€å…³
        this.cmd_setLight = 6; // è®¾ç½®ç¯å¼€å…³
        // åé¦ˆç»“æžœ
        this.result_success = 0; // æˆåŠŸ
    }
    /***************************************************************
     * å‡½æ•°åç§°: setDeviceId_Zero
     * è¯´    æ˜Ž: å°†è®¾å¤‡å·é…ç½®ä¸º0
     * å‚    æ•°: æ— 
     * è¿” å›ž å€¼: è¿”å›žå­—ç¬¦ä¸²
     ***************************************************************/
    setDeviceId_Zero() {
        let size = this.length_device_id;
        let str = "";
        let i = 0;
        for (i = 0; i < size; i++) {
            str += String.fromCharCode(0);
        }
        return str;
    }
    /***************************************************************
     * å‡½æ•°åç§°: print
     * è¯´    æ˜Ž: æ‰“å°æŠ¥æ–‡
     * å‚    æ•°:
     *      @packet     åè®®åŒ…
     * è¿” å›ž å€¼: æ— 
     ***************************************************************/
    print(packet) {
        let value = this.parsePacket(packet);
        if (value.result != ProtocolResult.ProtocolResult_Success) {
            console.log("Protocol: print => packet length is error, length=" + packet.length);
            return;
        }
        // æ‰“å°è®¾å¤‡å·
        let deviceId = value.deviceId;
        console.log("Protocol: device id => " + deviceId);
        // æ‰“å°è®¾å¤‡ç±»åž‹
        let deviceType = value.deviceType;
        console.log("Protocol: device type => " + deviceType);
        // æ‰“å°å‘½ä»¤ç±»åž‹
        let cmd = value.command;
        console.log("Protocol: cmd => " + cmd);
        // æ‰“å°è¿”å›žå€¼
        let res = value.result;
        console.log("Protocol: result => " + res);
        // æ‰“å°æ•°æ®éƒ¨åˆ†
        let data = value.data;
        console.log("Protocol: data => " + data);
        console.log("Protocol: data.charCodeAt() => " + data.charCodeAt(0));
    }
    /***************************************************************
     * å‡½æ•°åç§°: composePacket
     * è¯´    æ˜Ž: ç»„å»ºæŠ¥æ–‡
     * å‚    æ•°:
     *      @deviceId     è®¾å¤‡ç¼–å·
     *      @deviceType   è®¾å¤‡ç±»åž‹
     *      @cmd          å‘½ä»¤ç±»åž‹
     *      @result       æŠ¥æ–‡ç»“æžœ
     *      @data         æ•°æ®å†…å®¹
     * è¿” å›ž å€¼:
     *      @result       è¿”å›žç»“æžœï¼Œtrueä¸ºæˆåŠŸï¼Œfalseä¸ºå¤±è´¥
     *      @packet       è¿”å›žåè®®åŒ…
     ***************************************************************/
    composePacket(deviceId, deviceType, cmd, result, data) {
        let res = ProtocolResult.ProtocolResult_Success;
        let packet_string = "";
        // åŠ å…¥è®¾å¤‡å·
        if (deviceId.length < this.length_device_id) {
            // è®¾å¤‡å·çš„å­—ç¬¦ä¸²é•¿åº¦å°äºŽè¦æ±‚é•¿åº¦
            let i = 0;
            packet_string = deviceId;
            for (i = 0; i < (this.length_device_id - deviceId.length); i++) {
                packet_string += String.fromCharCode(0);
            }
            packet_string += deviceId;
        }
        else if (deviceId.length > this.length_device_id) {
            // è®¾å¤‡å·çš„å­—ç¬¦ä¸²é•¿åº¦å¤§äºŽè¦æ±‚é•¿åº¦
            packet_string = deviceId.substr(this.offset_device_id, this.length_device_id);
        }
        else {
            packet_string = deviceId;
        }
        // åŠ å…¥è®¾å¤‡ç±»åž‹
        let type_h = (deviceType >> 8) & 0xFF;
        let type_l = deviceType & 0xFF;
        packet_string += String.fromCharCode(type_h);
        packet_string += String.fromCharCode(type_l);
        // åŠ å…¥å‘½ä»¤
        let cmd_h = (cmd >> 8) & 0xFF;
        let cmd_l = cmd & 0xFF;
        packet_string += String.fromCharCode(cmd_h);
        packet_string += String.fromCharCode(cmd_l);
        // åŠ å…¥è¿”å›žå€¼
        result = result & 0xFF;
        packet_string += String.fromCharCode(result);
        // æ·»åŠ æ•°æ®éƒ¨åˆ†
        packet_string += data;
        return { result: res, packet: packet_string };
    }
    /***************************************************************
     * å‡½æ•°åç§°: parsePacket
     * è¯´    æ˜Ž: è§£æžåè®®æŠ¥æ–‡
     * å‚    æ•°:
     *        @packet       åè®®æŠ¥æ–‡
     * è¿” å›ž å€¼:
     *        @deviceId     è¿”å›žè®¾å¤‡ç¼–å·
     *        @deviceType   è¿”å›žè®¾å¤‡ç±»åž‹
     *        @command      è¿”å›žå‘½ä»¤ç±»åž‹
     *        @result       è¿”å›žç»“æžœï¼Œtrueä¸ºæˆåŠŸï¼Œfalseä¸ºå¤±è´¥
     *        @data         æ•°æ®å†…å®¹
     ***************************************************************/
    parsePacket(packet) {
        let id = "";
        let type = 0;
        let cmd = 0;
        let res = ProtocolResult.ProtocolResult_Success;
        let da = "";
        if (packet.length < 16) {
            res = ProtocolResult.ProtocolResult_PacketLength;
            return { deviceId: id, deviceType: type, command: cmd, result: res, data: da };
        }
        else {
            // èŽ·å–è®¾å¤‡å·
            id = packet.substr(this.offset_device_id, this.length_device_id);
            // èŽ·å–è®¾å¤‡ç±»åž‹
            let type_str = packet.substr(this.offset_device_type, this.length_device_type);
            let type_h = type_str.charCodeAt(0);
            let type_l = type_str.charCodeAt(1);
            type = (type_h << 8) + (type_l);
            // èŽ·å–å‘½ä»¤
